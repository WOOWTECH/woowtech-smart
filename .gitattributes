# woowtech smart: text files are LF everywhere, also on Windows, where Git's default
# core.autocrlf=true would hand out CRLF and the merge guards that read the sources would fail.
* text=auto eol=lf
# woowtech smart: cmd.exe reads batch files with CRLF line ends (README §31, plan G16).
*.cmd text eol=crlf
*.bat text eol=crlf
